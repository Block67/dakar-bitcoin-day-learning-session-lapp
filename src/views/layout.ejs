<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8">
    <title>Sigil — Private Identity on Bitcoin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        * { font-family: 'Outfit', sans-serif !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="antialiased text-white bg-black h-full overflow-hidden">
    
    <!-- Navbar globale Sigil -->
    <header class="fixed top-0 left-0 right-0 z-40 bg-black/50 backdrop-blur-md">
        <div class="sm:px-6 lg:px-8 max-w-7xl mx-auto px-4">
            <nav class="flex h-20 items-center justify-between">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-medium tracking-tight">Sigil</span>
                </a>

                <div class="hidden md:flex bg-white/5 border-white/10 border rounded-full p-1 gap-x-1 items-center">
                    <a href="/" class="px-4 py-2 text-sm font-medium text-white/80 hover:text-white transition">Protocol</a>
                    <a href="#features" class="px-4 py-2 text-sm font-medium text-white/80 hover:text-white transition">Security</a>
                    
                    <% if(!user) { %>
                        <button onclick="openModal()" class="ml-2 bg-white text-black text-sm font-bold px-6 py-2 rounded-full hover:bg-neutral-200 transition">
                            Enter Sigil
                        </button>
                    <% } else { %>
                        <div class="flex items-center gap-2 ml-2">
                            <a href="/profile" class="bg-white/10 border border-white/10 text-white text-sm font-bold px-6 py-2 rounded-full hover:bg-white/20 transition flex items-center gap-2">
                                <i data-lucide="shield" class="w-4 h-4 text-orange-500"></i>
                                <%= user.id.substring(0, 8) %>
                            </a>
                            <a href="/logout" class="p-2 text-white/50 hover:text-red-400 transition" title="Logout">
                                <i data-lucide="log-out" class="w-5 h-5"></i>
                            </a>
                        </div>
                    <% } %>
                </div>
            </nav>
        </div>
    </header>

    <%- body %>

    <!-- Modal Sigil -->
    <div id="signin" class="modal fixed inset-0 z-[100] hidden flex items-center justify-center p-4 bg-black/90 backdrop-blur-md transition-opacity duration-200">
        <div class="bg-neutral-900 border border-white/10 rounded-3xl p-8 max-w-md w-full relative shadow-2xl">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-white/40 hover:text-white transition">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <div class="text-center">
                <div class="w-16 h-16 bg-orange-500/10 border border-orange-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6">
                    <i data-lucide="zap" class="w-8 h-8 text-orange-500"></i>
                </div>
                <h3 class="text-2xl font-bold mb-2">Initialize Sigil</h3>
                <p class="text-white/60 text-sm mb-8">Proof of ownership required via Lightning.</p>
                <div class="qr-container mx-auto inline-block mb-6 hidden">
                    <a class="qr-link" href="#">
                        <img class="qr mx-auto bg-white p-2 rounded-xl" src="" alt="Sigil QR">
                    </a>
                </div>
                <div class="modal-footer justify-content-center hidden">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-orange-500 mx-auto mb-4"></div>
                    <p class="text-[10px] uppercase tracking-widest text-white/30 font-bold">Verifying Signature...</p>
                </div>
            </div>
        </div>
    </div>

    <script src="js/signin.js"></script>
    <script>
        lucide.createIcons();
        function openModal() {
            const modal = document.getElementById('signin');
            modal.classList.remove('hidden');
            if (typeof signin === 'function') signin();
        }
        function closeModal() {
            const modal = document.getElementById('signin');
            modal.classList.add('hidden');
        }
    </script>
</body>
</html>
